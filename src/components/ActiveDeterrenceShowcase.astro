---
// Component: ActiveDeterrenceShowcase.astro
// Positioned directly below ServicesGrid (Professional Security Services)
// Features Dahua TiOC: Cameras That Fight Back (Animated Sound & Light Alarm)
---

<section class="py-20 sm:py-24 bg-white dark:bg-slate-950 border-b border-slate-200 dark:border-white/10 relative overflow-hidden transition-colors duration-300" id="active-deterrence">
  <!-- Ambient Backlight Strobes (Dual Red & Blue Lighting) -->
  <div class="absolute top-1/4 left-10 w-96 h-96 bg-red-600/10 dark:bg-red-600/15 rounded-full blur-3xl pointer-events-none -z-10"></div>
  <div class="absolute bottom-1/4 right-10 w-96 h-96 bg-blue-600/10 dark:bg-blue-600/15 rounded-full blur-3xl pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header Strip -->
    <div class="text-center max-w-3xl mx-auto mb-14 space-y-4">
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-red-50 dark:bg-red-950/70 border border-red-200 dark:border-red-800/60 text-red-700 dark:text-red-400 text-xs font-black uppercase tracking-wider shadow-sm">
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-600"></span>
        </span>
        <span>TOTAL PERIMETER AWARENESS • CAMERAS THAT FIGHT BACK</span>
      </div>

      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
        Total Perimeter Awareness: <span class="text-transparent bg-clip-text bg-gradient-to-r from-red-600 via-amber-500 to-blue-600">Cameras That Fight Back</span>
      </h2>

      <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg leading-relaxed">
        Traditional CCTV cameras only record crimes after they happen. Dahua's Three-in-One Camera (TiOC) actively prevents break-ins with automated red &amp; blue police strobes, an ear-piercing 110dB siren, and full-colour night surveillance the instant a boundary line is crossed.
      </p>
    </div>

    <!-- 2-Column Responsive Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Camera Showcase Card (lg:col-span-5) -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none group" id="tioc-card-container">
          
          <!-- Outer Pulsing Glow Aura -->
          <div class="absolute -inset-1.5 bg-gradient-to-r from-red-500/30 via-slate-800 to-blue-500/30 dark:from-red-500/40 dark:via-cyan-500/20 dark:to-blue-500/40 rounded-[28px] sm:rounded-[36px] blur-xl transition-all duration-700" id="tioc-glow-aura"></div>

          <!-- Main Framed Showcase Container -->
          <div class="relative rounded-[24px] sm:rounded-[32px] p-2.5 sm:p-3 bg-white/90 dark:bg-slate-900/90 backdrop-blur-xl border-2 border-slate-200 dark:border-white/15 shadow-2xl transition-all duration-500 overflow-hidden" id="tioc-main-card">
            
            <!-- Top Badges Row -->
            <div class="flex items-center justify-between gap-2 p-2 relative z-20">
              <div class="px-3 py-1 rounded-full bg-slate-900/85 text-white text-[11px] font-black uppercase tracking-wider flex items-center gap-1.5 border border-white/20 shadow-md">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                <span>Cameras That Fight Back</span>
              </div>

              <div class="px-3 py-1 rounded-full bg-blue-600/90 text-white text-[11px] font-black uppercase tracking-wider shadow-md border border-cyan-400/40">
                <span>Dahua TiOC 2.0</span>
              </div>
            </div>

            <!-- Image Canvas: Cameras That Fight Back Animated GIF -->
            <div class="relative rounded-[18px] sm:rounded-[24px] overflow-hidden aspect-square bg-slate-950 flex items-center justify-center group-hover:shadow-inner transition-all border border-slate-800">
              
              <!-- Subtle Holographic Grid Pattern in Dark Mode -->
              <div class="absolute inset-0 bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:16px_16px] opacity-10 pointer-events-none"></div>

              <!-- Animated GIF: Cameras That Fight Back -->
              <img 
                src="/cameras-that-fight-back.gif" 
                alt="Cameras That Fight Back - Dahua WizSense TiOC Active Deterrence Strobe and Sound Alarm" 
                class="w-full h-full object-cover object-center relative z-10 transform group-hover:scale-102 transition-transform duration-700"
                loading="eager"
              />

              <!-- Interactive Strobe Simulator Overlay (Hidden by default, triggered on test button click) -->
              <div id="tioc-strobe-overlay" class="absolute inset-0 z-20 pointer-events-none opacity-0 transition-opacity duration-200">
                <div class="absolute inset-0 strobe-flash-red-blue"></div>
                <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 px-4 py-2 rounded-xl bg-red-600/95 text-white font-mono font-black text-xs uppercase tracking-widest shadow-2xl border border-white/40 flex items-center gap-2 animate-pulse text-center">
                  <span>🚨 110dB SIREN &amp; STROBE TRIGGERED</span>
                </div>
              </div>

              <!-- Color Finish Indicators (Tags) -->
              <div class="absolute bottom-3 inset-x-3 flex items-center justify-between gap-2 z-20 text-[10px] sm:text-[11px] font-bold">
                <div class="px-2.5 py-1 rounded-lg bg-slate-900/90 backdrop-blur-md text-white border border-white/20 shadow-md flex items-center gap-1.5">
                  <span class="w-2 h-2 rounded-full bg-red-500 animate-ping"></span>
                  <span>Sound &amp; Light Alarm</span>
                </div>
                <div class="px-2.5 py-1 rounded-lg bg-slate-900/90 backdrop-blur-md text-cyan-300 border border-cyan-400/30 shadow-md flex items-center gap-1.5 font-mono">
                  <span>WizSense AI</span>
                </div>
              </div>

            </div>

            <!-- Bottom Specs & Interactive Trigger Row -->
            <div class="p-3 sm:p-4 space-y-3">
              
              <!-- Hardware Specs Pills -->
              <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center text-[10px] font-black uppercase tracking-wider">
                <div class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-white/5">
                  🔴🔵 Dual Strobes
                </div>
                <div class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-white/5">
                  🔊 110dB Siren
                </div>
                <div class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-white/5">
                  💡 Full-Color
                </div>
                <div class="p-2 rounded-xl bg-slate-100 dark:bg-slate-800/80 text-slate-800 dark:text-slate-200 border border-slate-200 dark:border-white/5">
                  🛡️ IP67 Metal
                </div>
              </div>

              <!-- Interactive Simulator Trigger Button -->
              <button 
                type="button"
                id="trigger-strobe-btn"
                onclick="simulateTiocAlarm()"
                class="w-full py-2.5 rounded-xl bg-gradient-to-r from-red-600 via-slate-900 to-blue-600 hover:from-red-500 hover:to-blue-500 text-white text-xs font-black uppercase tracking-wider shadow-lg shadow-red-500/20 transition-all flex items-center justify-center gap-2 cursor-pointer border border-white/20 active:scale-98"
              >
                <span>🚨 Test Active Siren &amp; Strobe Effect</span>
                <span id="strobe-btn-timer" class="hidden font-mono bg-white/20 px-1.5 py-0.5 rounded text-[10px]">4s</span>
              </button>

            </div>

          </div>
        </div>
      </div>

      <!-- Right Column: 4 Core Capabilities & Architectural Color Matching (lg:col-span-7) -->
      <div class="lg:col-span-7 space-y-6">
        
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/60 text-blue-700 dark:text-blue-400 text-xs font-black uppercase tracking-wider mb-2.5">
            <span>Three Technologies • One Intelligent Camera</span>
          </div>
          <h3 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
            How TiOC Actively Defends Your Carindale Home
          </h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mt-2">
            Engineered specifically to counter opportunistic property crime, fence jumping, and driveway intrusions across Brisbane East.
          </p>
        </div>

        <!-- 4 Feature Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          
          <!-- Feature 1: Dual Red & Blue Strobes -->
          <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-white/10 shadow-sm hover:border-red-400/60 dark:hover:border-red-500/60 transition-all space-y-2 group">
            <div class="w-9 h-9 rounded-xl bg-red-500/15 text-red-600 dark:text-red-400 flex items-center justify-center text-lg font-bold group-hover:scale-110 transition-transform">
              🚨
            </div>
            <h4 class="text-base font-black text-slate-900 dark:text-white">
              Red &amp; Blue Police Strobes
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              High-visibility flashing police lights disorient trespassers the instant your boundary line is crossed, sending a clear psychological signal that they are caught on live camera.
            </p>
          </div>

          <!-- Feature 2: High-Decibel Siren & Voice Warnings -->
          <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-white/10 shadow-sm hover:border-amber-400/60 dark:hover:border-amber-500/60 transition-all space-y-2 group">
            <div class="w-9 h-9 rounded-xl bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg font-bold group-hover:scale-110 transition-transform">
              📢
            </div>
            <h4 class="text-base font-black text-slate-900 dark:text-white">
              110dB Siren &amp; Spoken Voice
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              Built-in speaker sounds an ear-piercing siren or broadcasts custom audio warnings like: <em>"Warning: You are in a restricted security zone. Please leave immediately."</em>
            </p>
          </div>

          <!-- Feature 3: Smart Dual Illuminators (Full-Color) -->
          <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-white/10 shadow-sm hover:border-blue-400/60 dark:hover:border-blue-500/60 transition-all space-y-2 group">
            <div class="w-9 h-9 rounded-xl bg-blue-500/15 text-blue-600 dark:text-blue-400 flex items-center justify-center text-lg font-bold group-hover:scale-110 transition-transform">
              💡
            </div>
            <h4 class="text-base font-black text-slate-900 dark:text-white">
              Smart Full-Colour Night Light
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              Operates in discreet stealth IR at night, but instantly activates a warm white floodlight when a human or vehicle appears — capturing true vehicle paint and clothing colors for police evidence.
            </p>
          </div>

          <!-- Feature 4: AI WizSense False Alarm Filter -->
          <div class="p-4 sm:p-5 rounded-2xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-white/10 shadow-sm hover:border-emerald-400/60 dark:hover:border-emerald-500/60 transition-all space-y-2 group">
            <div class="w-9 h-9 rounded-xl bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-lg font-bold group-hover:scale-110 transition-transform">
              🧠
            </div>
            <h4 class="text-base font-black text-slate-900 dark:text-white">
              AI WizSense 99% Accuracy
            </h4>
            <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed">
              Never be woken by wind, tree shadows, heavy Queensland storms, or possums. Dahua's neural deep-learning algorithm triggers alarms strictly for humans and vehicles.
            </p>
          </div>

        </div>

        <!-- Architectural Color Callout: White vs Black Housing -->
        <div class="p-4 rounded-2xl bg-slate-100 dark:bg-slate-900 border border-slate-200 dark:border-white/10 flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-slate-950 to-slate-100 p-0.5 shrink-0 shadow-md">
            <div class="w-full h-full rounded-[14px] bg-slate-900 flex items-center justify-center text-xl text-white">
              🎨
            </div>
          </div>
          <div class="space-y-0.5 text-xs sm:text-sm">
            <div class="font-black text-slate-900 dark:text-white">
              Architectural Matching: Alpine White &amp; Midnight Black
            </div>
            <p class="text-slate-600 dark:text-slate-400 leading-relaxed">
              We stock both colourways so your security blends in seamlessly. Choose <strong>Alpine White</strong> for eaves and rendered brickwork, or <strong>Midnight Black</strong> to match modern Monument® Colorbond® gutters, dark timber, and charcoal fascias.
            </p>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="pt-2 flex flex-wrap items-center gap-3">
          <a 
            href="#quote" 
            onclick="prefillQuote('Dahua 4K TiOC Active Deterrence System', 'Home / Residential')"
            class="px-7 py-3.5 rounded-xl bg-gradient-to-r from-red-600 via-amber-600 to-blue-600 hover:from-red-500 hover:to-blue-500 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-red-600/25 transition-all transform hover:-translate-y-0.5 cursor-pointer"
          >
            Claim TiOC Installation Quote &rarr;
          </a>

          <a 
            href="tel:0731000000" 
            class="px-6 py-3.5 rounded-xl bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-bold text-xs flex items-center gap-2 transition-all"
          >
            <span>Direct Call: (07) 3100 0000</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>

<!-- Scoped Animations & Strobe Simulation Script -->
<style>
  @keyframes strobe-police-flash {
    0%, 100% {
      background: radial-gradient(circle at 35% 65%, rgba(239, 68, 68, 0.45) 0%, transparent 60%);
    }
    50% {
      background: radial-gradient(circle at 65% 35%, rgba(59, 130, 246, 0.45) 0%, transparent 60%);
    }
  }

  .strobe-flash-red-blue {
    animation: strobe-police-flash 0.25s infinite ease-in-out;
  }

  .alarm-active-card {
    animation: border-flash-pulse 0.4s infinite alternate;
  }

  @keyframes border-flash-pulse {
    0% {
      border-color: rgba(239, 68, 68, 0.9);
      box-shadow: 0 0 35px rgba(239, 68, 68, 0.5), inset 0 0 20px rgba(239, 68, 68, 0.2);
    }
    100% {
      border-color: rgba(59, 130, 246, 0.9);
      box-shadow: 0 0 35px rgba(59, 130, 246, 0.5), inset 0 0 20px rgba(59, 130, 246, 0.2);
    }
  }
</style>

<script is:inline>
  let strobeTimeout = null;
  let strobeInterval = null;

  window.simulateTiocAlarm = function() {
    const overlay = document.getElementById('tioc-strobe-overlay');
    const card = document.getElementById('tioc-main-card');
    const glow = document.getElementById('tioc-glow-aura');
    const timerSpan = document.getElementById('strobe-btn-timer');

    if (!overlay || !card) return;

    // Reset if already active
    if (strobeTimeout) clearTimeout(strobeTimeout);
    if (strobeInterval) clearInterval(strobeInterval);

    // Activate visual alarm state
    overlay.classList.remove('opacity-0');
    overlay.classList.add('opacity-100');
    card.classList.add('alarm-active-card');
    if (glow) {
      glow.classList.add('from-red-600', 'to-blue-600', 'blur-2xl');
    }

    // Update button countdown
    if (timerSpan) {
      timerSpan.classList.remove('hidden');
      let countdown = 4;
      timerSpan.textContent = countdown + 's';
      strobeInterval = setInterval(() => {
        countdown--;
        if (countdown > 0) {
          timerSpan.textContent = countdown + 's';
        } else {
          clearInterval(strobeInterval);
        }
      }, 1000);
    }

    // Auto turn off after 4 seconds
    strobeTimeout = setTimeout(() => {
      overlay.classList.remove('opacity-100');
      overlay.classList.add('opacity-0');
      card.classList.remove('alarm-active-card');
      if (timerSpan) timerSpan.classList.add('hidden');
      if (strobeInterval) clearInterval(strobeInterval);
    }, 4000);
  };
</script>
