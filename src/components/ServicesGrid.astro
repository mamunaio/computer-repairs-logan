---
// Component: ServicesGrid.astro
---
<!-- 4. PRIMARY SERVICES (WIREFRAME BLOCK 4 - 6 EXPANDED CARDS) -->
  <section id="services" class="py-20 relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-black text-blue-600 dark:text-blue-400 uppercase tracking-widest px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800/50">
          Professional Security Services
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mt-3 tracking-tight">
          CCTV Installation Services in Carindale
        </h2>
        <!-- Strict wireframe lead preserved -->
        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
          Give visitors a fast route to the service matching their problem. Tailored for local Queensland properties and council compliance.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">
        
        <!-- Card 1: Home CCTV -->
        <div class="glass-box p-7 rounded-3xl border border-slate-200 dark:border-white/10 hover:border-blue-500 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-2xl bg-blue-600/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                🏠
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950 text-blue-600 dark:text-blue-400 border border-blue-200 dark:border-blue-800/50">
                Residential
              </span>
            </div>
            <h3 class="text-xl font-black text-slate-900 dark:text-white mb-2">Home CCTV</h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
              Driveways, entrances, side access, yards, garages and detached buildings. Concealed cabling designed for high architectural aesthetics.
            </p>
            <ul class="space-y-2.5 text-sm sm:text-base text-slate-500 dark:text-slate-400 mb-6">
              <li class="flex items-start gap-2.5"><span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span> <span>Zero blind spots on perimeter</span></li>
              <li class="flex items-start gap-2.5"><span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span> <span>Smartphone push alerts when motion triggered</span></li>
              <li class="flex items-start gap-2.5"><span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span> <span>4K resolution license plate clarity</span></li>
            </ul>
          </div>
          <button onclick="prefillQuote('Home CCTV Installation', 'Home / Residential')" class="w-full py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-blue-600 hover:text-white font-black text-sm text-slate-800 dark:text-slate-200 transition-all flex items-center justify-center gap-1.5">
            <span>Quote Home System</span>
            <span>&rarr;</span>
          </button>
        </div>

        <!-- Card 2: Business CCTV -->
        <div class="glass-box p-7 rounded-3xl border border-slate-200 dark:border-white/10 hover:border-cyan-500 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-2xl bg-cyan-600/10 text-cyan-600 dark:text-cyan-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                🏢
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full bg-cyan-50 dark:bg-cyan-950 text-cyan-600 dark:text-cyan-400 border border-cyan-200 dark:border-cyan-800/50">
                Commercial
              </span>
            </div>
            <h3 class="text-xl font-black text-slate-900 dark:text-white mb-2">Business CCTV</h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
              Shops, offices, restaurants, warehouses, strata and property managers. Compliant with Queensland workplace privacy regulations.
            </p>
            <ul class="space-y-2.5 text-sm sm:text-base text-slate-500 dark:text-slate-400 mb-6">
              <li class="flex items-start gap-2.5"><span class="text-cyan-500 font-bold shrink-0 mt-0.5">✓</span> <span>Till &amp; cash register point-of-sale zoom</span></li>
              <li class="flex items-start gap-2.5"><span class="text-cyan-500 font-bold shrink-0 mt-0.5">✓</span> <span>Multi-user permission management for staff</span></li>
              <li class="flex items-start gap-2.5"><span class="text-cyan-500 font-bold shrink-0 mt-0.5">✓</span> <span>30 to 60+ days continuous local storage</span></li>
            </ul>
          </div>
          <button onclick="prefillQuote('Business CCTV Installation', 'Commercial Business')" class="w-full py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-cyan-600 hover:text-white font-black text-sm text-slate-800 dark:text-slate-200 transition-all flex items-center justify-center gap-1.5">
            <span>Quote Commercial System</span>
            <span>&rarr;</span>
          </button>
        </div>

        <!-- Card 3: Repairs & Upgrades -->
        <div class="glass-box p-7 rounded-3xl border border-slate-200 dark:border-white/10 hover:border-amber-500 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-2xl bg-amber-600/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                🔧
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full bg-amber-50 dark:bg-amber-950 text-amber-600 dark:text-amber-400 border border-amber-200 dark:border-amber-800/50">
                Troubleshooting
              </span>
            </div>
            <h3 class="text-xl font-black text-slate-900 dark:text-white mb-2">Repairs &amp; Upgrades</h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
              Offline cameras, failed recorders, app access, hard drives and analogue-to-IP upgrades. Fast diagnostic and restoration of dead video feeds.
            </p>
            <ul class="space-y-2.5 text-sm sm:text-base text-slate-500 dark:text-slate-400 mb-6">
              <li class="flex items-start gap-2.5"><span class="text-amber-500 font-bold shrink-0 mt-0.5">✓</span> <span>Corrupt NVR hard drive replacement</span></li>
              <li class="flex items-start gap-2.5"><span class="text-amber-500 font-bold shrink-0 mt-0.5">✓</span> <span>Router/NBN network reconnection &amp; app fix</span></li>
              <li class="flex items-start gap-2.5"><span class="text-amber-500 font-bold shrink-0 mt-0.5">✓</span> <span>Upgrade grainy 720p to 4K Digital PoE</span></li>
            </ul>
          </div>
          <button onclick="prefillQuote('CCTV Repair or Upgrade', 'Home / Residential')" class="w-full py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-amber-600 hover:text-white font-black text-sm text-slate-800 dark:text-slate-200 transition-all flex items-center justify-center gap-1.5">
            <span>Book a Repair</span>
            <span>&rarr;</span>
          </button>
        </div>

        <!-- Card 4: BYO Installation -->
        <div class="glass-box p-7 rounded-3xl border border-slate-200 dark:border-white/10 hover:border-emerald-500 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-2xl bg-emerald-600/10 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                📦
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950 text-emerald-600 dark:text-emerald-400 border border-emerald-200 dark:border-emerald-800/50">
                Customer Hardware
              </span>
            </div>
            <h3 class="text-xl font-black text-slate-900 dark:text-white mb-2">BYO Installation</h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
              Mounting and cabling for compatible customer-supplied systems (Swann, Reolink, Eufy, Lorex, Hikvision), with a clear warranty boundary.
            </p>
            <ul class="space-y-2.5 text-sm sm:text-base text-slate-500 dark:text-slate-400 mb-6">
              <li class="flex items-start gap-2.5"><span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span> <span>Professional concealed Cat6 cabling</span></li>
              <li class="flex items-start gap-2.5"><span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span> <span>Optimal camera angle placement</span></li>
              <li class="flex items-start gap-2.5"><span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span> <span>Written cabling workmanship warranty</span></li>
            </ul>
          </div>
          <button onclick="prefillQuote('BYO Camera Installation', 'Home / Residential')" class="w-full py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-emerald-600 hover:text-white font-black text-sm text-slate-800 dark:text-slate-200 transition-all flex items-center justify-center gap-1.5">
            <span>Quote BYO Setup</span>
            <span>&rarr;</span>
          </button>
        </div>

        <!-- Card 5: Active Deterrence (With Soft Alternating Red & Blue Police Strobe Pulse) -->
        <div class="glass-box active-deterrence-strobe p-7 rounded-3xl border-2 border-red-500/30 transition-all flex flex-col justify-between group relative overflow-hidden">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="relative w-12 h-12 rounded-2xl bg-gradient-to-tr from-red-600/15 to-blue-600/15 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                <span>🚨</span>
                <!-- Tiny soft dual police beacon dots -->
                <span class="absolute -top-1 -right-1 flex gap-1">
                  <span class="w-2 h-2 rounded-full bg-red-500 beacon-dot-red shadow-[0_0_8px_rgba(239,68,68,0.9)]"></span>
                  <span class="w-2 h-2 rounded-full bg-blue-500 beacon-dot-blue shadow-[0_0_8px_rgba(59,130,246,0.9)]"></span>
                </span>
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full bg-red-50 dark:bg-red-950/80 text-red-600 dark:text-red-400 border border-red-500/30 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-ping"></span>
                <span>Active AI Strobe</span>
              </span>
            </div>
            <h3 class="text-xl font-black text-slate-900 dark:text-white mb-2">Active Deterrence</h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
              Lighting, sirens and human or vehicle detection where the site and customer need suit. Stop intruders before they break in.
            </p>
            <ul class="space-y-2.5 text-sm sm:text-base text-slate-500 dark:text-slate-400 mb-6">
              <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0 mt-0.5">✓</span> <span>Flashing red &amp; blue strobe lights</span></li>
              <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0 mt-0.5">✓</span> <span>Two-way talkback speaker &amp; microphone</span></li>
              <li class="flex items-start gap-2.5"><span class="text-red-500 font-bold shrink-0 mt-0.5">✓</span> <span>AI human target filtering (no spiderweb alerts)</span></li>
            </ul>
          </div>
          <button onclick="prefillQuote('Active Deterrence Package', 'Home / Residential')" class="w-full py-3 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-red-600 hover:text-white font-black text-sm text-slate-800 dark:text-slate-200 transition-all flex items-center justify-center gap-1.5">
            <span>Explore Active Defense</span>
            <span>&rarr;</span>
          </button>
        </div>

        <!-- Card 6: Remote Viewing -->
        <div class="glass-box p-7 rounded-3xl border border-slate-200 dark:border-white/10 hover:border-purple-500 transition-all flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-12 h-12 rounded-2xl bg-purple-600/10 text-purple-600 dark:text-purple-400 flex items-center justify-center text-2xl group-hover:scale-110 transition-transform">
                📱
              </div>
              <span class="text-[10px] font-black uppercase tracking-wider px-2.5 py-1 rounded-full bg-purple-50 dark:bg-purple-950 text-purple-600 dark:text-purple-400 border border-purple-200 dark:border-purple-800/50">
                Anywhere Access
              </span>
            </div>
            <h3 class="text-xl font-black text-slate-900 dark:text-white mb-2">Remote Viewing</h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mb-4">
              Secure phone, tablet and computer access, configured and explained before handover. Check your property from anywhere in the world.
            </p>
            <ul class="space-y-2.5 text-sm sm:text-base text-slate-500 dark:text-slate-400 mb-6">
              <li class="flex items-start gap-2.5"><span class="text-purple-500 font-bold shrink-0 mt-0.5">✓</span> <span>Direct P2P encrypted secure connection</span></li>
              <li class="flex items-start gap-2.5"><span class="text-purple-500 font-bold shrink-0 mt-0.5">✓</span> <span>Multi-user accounts for family &amp; managers</span></li>
              <li class="flex items-start gap-2.5"><span class="text-purple-500 font-bold shrink-0 mt-0.5">✓</span> <span>Patient training on exporting incident clips</span></li>
            </ul>
          </div>
          <div class="space-y-2">
            <a href="#remote-viewing" class="w-full py-2.5 rounded-xl bg-purple-600/15 hover:bg-purple-600 hover:text-white text-purple-700 dark:text-purple-300 font-black text-xs uppercase tracking-wider text-center transition-all flex items-center justify-center gap-1.5 border border-purple-500/30">
              <span>Interactive App Demo</span>
              <span>&darr;</span>
            </a>
            <button onclick="prefillQuote('Remote Viewing Setup', 'Home / Residential')" class="w-full py-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 hover:bg-purple-600 hover:text-white font-black text-xs uppercase tracking-wider text-slate-800 dark:text-slate-200 transition-all flex items-center justify-center gap-1.5">
              <span>Setup Remote App</span>
              <span>&rarr;</span>
            </button>
          </div>
        </div>

      </div>

    </div>
  </section>

<style>
  @keyframes police-strobe-pulse {
    0%, 100% {
      border-color: rgba(239, 68, 68, 0.45);
      box-shadow: 0 0 25px -4px rgba(239, 68, 68, 0.22), inset 0 0 15px -4px rgba(239, 68, 68, 0.08);
    }
    50% {
      border-color: rgba(59, 130, 246, 0.45);
      box-shadow: 0 0 25px -4px rgba(59, 130, 246, 0.22), inset 0 0 15px -4px rgba(59, 130, 246, 0.08);
    }
  }

  .active-deterrence-strobe {
    animation: police-strobe-pulse 3.2s ease-in-out infinite;
  }

  @keyframes beacon-flash-red {
    0%, 100% { opacity: 1; transform: scale(1.05); }
    50% { opacity: 0.2; transform: scale(0.85); }
  }
  @keyframes beacon-flash-blue {
    0%, 100% { opacity: 0.2; transform: scale(0.85); }
    50% { opacity: 1; transform: scale(1.05); }
  }

  .beacon-dot-red {
    animation: beacon-flash-red 1.6s ease-in-out infinite;
  }
  .beacon-dot-blue {
    animation: beacon-flash-blue 1.6s ease-in-out infinite;
  }
</style>
