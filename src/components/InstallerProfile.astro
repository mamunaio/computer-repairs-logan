---
// Component: InstallerProfile.astro
// Professional Installer Profile Card showcasing Certified Credentials & Local Expertise
---

<section id="installer-profile" class="py-20 relative overflow-hidden bg-slate-50 dark:bg-slate-900/60 border-y border-slate-200 dark:border-white/10 scroll-mt-24">
  <!-- Subtle Ambient Glows -->
  <div class="absolute top-1/3 -right-24 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 -left-20 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Heading -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-black text-blue-600 dark:text-blue-400 uppercase tracking-widest px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800/50">
        Dedicated Local Specialist
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mt-3 tracking-tight">
        Meet Your Certified Installer
      </h2>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
        Personal, accountable security installations by an experienced Carindale local — never outsourced to rushed third-party subcontractors.
      </p>
    </div>

    <!-- Main Profile Card Container -->
    <div class="glass-box rounded-3xl p-6 sm:p-10 lg:p-12 border-2 border-slate-200 dark:border-white/15 relative shadow-2xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Left Column: Portrait & Field Work Photos Showcase (lg:col-span-5) -->
        <div class="lg:col-span-5 space-y-4">
          
          <!-- 1. Installer Portrait Frame / Placeholder -->
          <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden border-2 border-blue-500/40 bg-slate-950 shadow-xl group">
            <div class="aspect-[4/4.5] sm:aspect-[4/4.2] w-full relative overflow-hidden bg-gradient-to-t from-slate-950 via-slate-900 to-slate-800 flex items-center justify-center">
              
              <!-- Placeholder Graphic / Portrait Representation -->
              <div class="text-center p-6 space-y-3">
                <div class="w-24 h-24 sm:w-28 sm:h-28 mx-auto rounded-full bg-gradient-to-tr from-blue-600 to-cyan-500 p-1 shadow-xl shadow-cyan-500/20">
                  <div class="w-full h-full rounded-full bg-slate-900 flex items-center justify-center text-4xl sm:text-5xl">
                    👨‍🔧
                  </div>
                </div>
                <div>
                  <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-500/20 border border-blue-500/40 text-cyan-300 text-xs font-black tracking-wider uppercase">
                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>Lead Security Installer</span>
                  </div>
                  <h3 class="text-xl sm:text-2xl font-black text-white mt-2">Robert H.</h3>
                  <p class="text-xs sm:text-sm text-slate-300 font-medium">ACMA Master Cabler • QLD Security Installer</p>
                </div>
              </div>

              <!-- Top Floating Experience Tag -->
              <div class="absolute top-3.5 left-3.5 px-3 py-1 rounded-full bg-slate-950/85 backdrop-blur-md border border-white/20 text-white text-[11px] font-bold shadow-lg">
                <span>⭐ 15+ Years Local Experience</span>
              </div>

              <!-- Bottom Floating Caption -->
              <div class="absolute bottom-3 inset-x-3 p-2.5 rounded-xl bg-slate-950/90 backdrop-blur-md border border-white/10 text-center">
                <span class="text-[11px] text-slate-300 font-medium">[Installer Portrait Placeholder]</span>
              </div>
            </div>
          </div>

          <!-- 2. Dual Field Work Photo Placeholders -->
          <div class="grid grid-cols-2 gap-3.5">
            
            <!-- Field Work Photo 1 -->
            <div class="relative rounded-2xl overflow-hidden border border-slate-300 dark:border-white/15 bg-slate-950 aspect-video group">
              <img 
                src="/cctv-tidy-rack.jpg" 
                alt="Field Work: Structured Cat6 cabling and network rack installation"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-2.5 text-[10px] text-white font-bold">
                <span class="text-cyan-400 font-mono text-[9px] uppercase">FIELD WORK 01</span>
                <span>Tidy Cat6 Rack Cabling</span>
              </div>
            </div>

            <!-- Field Work Photo 2 -->
            <div class="relative rounded-2xl overflow-hidden border border-slate-300 dark:border-white/15 bg-slate-950 aspect-video group">
              <img 
                src="/cctv-real-camera.png" 
                alt="Field Work: Concealed eaves CCTV mount in Carindale"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent flex flex-col justify-end p-2.5 text-[10px] text-white font-bold">
                <span class="text-emerald-400 font-mono text-[9px] uppercase">FIELD WORK 02</span>
                <span>Concealed Eaves Mount</span>
              </div>
            </div>

          </div>

        </div>

        <!-- Right Column: Bio & Local Expertise Bullet Points (lg:col-span-7) -->
        <div class="lg:col-span-7 space-y-6">
          
          <div>
            <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-blue-500/10 text-blue-600 dark:text-blue-400 text-xs font-black uppercase tracking-wider mb-3">
              Direct Personal Service • Zero Subcontractors
            </div>
            <h3 class="text-2xl sm:text-3xl lg:text-4xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
              Experienced Local Craftsmanship You Can Trust
            </h3>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed mt-2.5">
              When you book with CCTV Carindale, you work directly with me from the first on-site security assessment to the final smartphone app walkthrough. No sales reps making unrealistic promises, and no rushed contract installers cutting corners behind your walls.
            </p>
          </div>

          <!-- Bullet Points Highlighting Local Expertise -->
          <div class="space-y-3.5 pt-1">
            
            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-blue-500/15 text-blue-600 dark:text-blue-400 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                ✓
              </div>
              <div class="text-sm sm:text-base">
                <strong class="text-slate-900 dark:text-white font-extrabold">15+ Years Hands-On Brisbane Experience:</strong>
                <span class="text-slate-600 dark:text-slate-300"> Extensive knowledge navigating Carindale's brick veneer, steep tile roofs, Colorbond trusses, and multi-storey cavities to route cables completely out of sight.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-cyan-500/15 text-cyan-600 dark:text-cyan-400 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                ✓
              </div>
              <div class="text-sm sm:text-base">
                <strong class="text-slate-900 dark:text-white font-extrabold">Licensed QLD Security Installer (Class 1 &amp; 2):</strong>
                <span class="text-slate-600 dark:text-slate-300"> Government-vetted and Queensland Police fingerprinted with comprehensive criminal background checks for total household security.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-emerald-500/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                ✓
              </div>
              <div class="text-sm sm:text-base">
                <strong class="text-slate-900 dark:text-white font-extrabold">ACMA Open Registered Master Cabler:</strong>
                <span class="text-slate-600 dark:text-slate-300"> Fully accredited for Cat6/6A data cabling, coaxial termination, and neat network rack patching at half the hourly billing rate of an electrician.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-purple-500/15 text-purple-600 dark:text-purple-400 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                ✓
              </div>
              <div class="text-sm sm:text-base">
                <strong class="text-slate-900 dark:text-white font-extrabold">Concealed Wiring &amp; Clean Home Policy:</strong>
                <span class="text-slate-600 dark:text-slate-300"> We treat your residence like our own. Work areas are vacuumed spotless, entry points are sealed weatherproof, and zero ugly surface conduits are left exposed.</span>
              </div>
            </div>

            <div class="flex items-start gap-3">
              <div class="w-7 h-7 rounded-lg bg-amber-500/15 text-amber-600 dark:text-amber-400 flex items-center justify-center font-bold text-sm shrink-0 mt-0.5">
                ✓
              </div>
              <div class="text-sm sm:text-base">
                <strong class="text-slate-900 dark:text-white font-extrabold">Direct Local After-Installation Support:</strong>
                <span class="text-slate-600 dark:text-slate-300"> You receive my personal mobile number for prompt assistance if you upgrade your phone, switch NBN routers, or need guidance extracting police evidence clips.</span>
              </div>
            </div>

          </div>

          <!-- Trust Badges Strip -->
          <div class="pt-2 grid grid-cols-2 sm:grid-cols-4 gap-3 text-center">
            <div class="p-3 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-white/10">
              <div class="text-lg font-black text-blue-600 dark:text-blue-400">500+</div>
              <div class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Local Installs</div>
            </div>
            <div class="p-3 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-white/10">
              <div class="text-lg font-black text-amber-500">5.0 ★</div>
              <div class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Google Rating</div>
            </div>
            <div class="p-3 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-white/10">
              <div class="text-lg font-black text-emerald-500">$20M</div>
              <div class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Public Liability</div>
            </div>
            <div class="p-3 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-white/10">
              <div class="text-lg font-black text-cyan-500">5-Year</div>
              <div class="text-[11px] font-bold text-slate-500 dark:text-slate-400">Workmanship</div>
            </div>
          </div>

          <!-- Buttons -->
          <div class="pt-3 flex flex-wrap items-center gap-3">
            <a href="#quote" onclick="prefillQuote('Site Assessment with Lead Installer', 'Home / Residential')" class="px-7 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-blue-600/30 transition-all transform hover:-translate-y-0.5">
              Book On-Site Assessment &rarr;
            </a>
            <a href="tel:0731000000" class="px-6 py-3.5 rounded-xl bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-bold text-xs flex items-center gap-2 transition-all">
              <span>Direct Call: (07) 3100 0000</span>
            </a>
          </div>

        </div>

      </div>
    </div>

  </div>
</section>
