---
// Component: PricingPackages.astro
---
<!-- 7. PRICING & PACKAGES (WIREFRAME BLOCK 7 - 3 PACKAGES + INTERACTIVE BUILDER) -->
  <section id="pricing" class="py-20 bg-slate-50 dark:bg-slate-900/60 border-y border-slate-200 dark:border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-3xl mx-auto mb-14">
        <span class="text-xs font-black text-blue-600 dark:text-blue-400 uppercase tracking-widest px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800/50">
          Upfront &amp; Guaranteed
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mt-3 tracking-tight">
          CCTV Packages and Pricing
        </h2>
        <!-- Strict wireframe lead preserved -->
        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
          Show meaningful starting prices and state the exact assumptions behind them. No hidden travel fees or unexpected call-out charges.
        </p>
      </div>

      <!-- 3 Tiered Packages -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8 items-stretch">
        
        <!-- Package 1: BYO Installation -->
        <div class="glass-box p-8 rounded-3xl border border-slate-200 dark:border-white/10 flex flex-col justify-between">
          <div class="space-y-4">
            <span class="px-3 py-1 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-700 dark:text-slate-300 text-xs font-black uppercase tracking-wider">
              Customer Supplied System
            </span>
            <h3 class="text-2xl font-black text-slate-900 dark:text-white">BYO Installation</h3>
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-black text-slate-900 dark:text-white">From $490</span>
              <span class="text-xs text-slate-500 dark:text-slate-400 font-bold">inc. GST</span>
            </div>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
              Professional mounting and structured cabling for systems you've purchased yourself from Swann, Reolink, Eufy, or Costco.
            </p>

            <div class="border-t border-slate-200 dark:border-white/10 pt-4 space-y-3 text-sm sm:text-base text-slate-600 dark:text-slate-300">
              <div class="flex items-start gap-2.5">
                <span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>Start from 1 Basic Wired Camera</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>Single-Storey Roof Space Assumed</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>Heavy-Duty Cat6 Cabling &amp; RJ45 Crimps</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>NVR Recorder Connection &amp; Display Setup</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-emerald-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>Smartphone App Setup for Household</span>
              </div>
              <div class="flex items-start gap-2.5 text-slate-400">
                <span class="font-bold shrink-0 mt-0.5">•</span>
                <span>Excludes camera manufacturer hardware warranty</span>
              </div>
            </div>
          </div>

          <div class="pt-6">
            <button onclick="prefillQuote('BYO Installation Package (From $490)', 'Home / Residential')" class="w-full py-3.5 rounded-xl bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-900 dark:text-white font-black text-sm uppercase tracking-wider transition-all">
              Book BYO Install &rarr;
            </button>
          </div>
        </div>

        <!-- Package 2: Essential Wired Package (Featured) -->
        <div class="glass-box p-8 rounded-3xl border-2 border-blue-600 relative flex flex-col justify-between shadow-2xl bg-white dark:bg-slate-900 scale-105 z-10">
          <div class="absolute -top-3.5 left-1/2 -translate-x-1/2 px-4 py-1 rounded-full bg-blue-600 text-white text-[10px] font-black tracking-wider uppercase shadow-md">
            Most Popular for Carindale Homes
          </div>

          <div class="space-y-4">
            <span class="px-3 py-1 rounded-full bg-blue-500/15 text-blue-600 dark:text-blue-400 text-xs font-black uppercase tracking-wider">
              Complete Turnkey 4K Solution
            </span>
            <h3 class="text-2xl font-black text-slate-900 dark:text-white">Essential Wired Package</h3>
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-black text-blue-600 dark:text-blue-400">From $1,690</span>
              <span class="text-xs text-slate-500 dark:text-slate-400 font-bold">inc. GST</span>
            </div>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
              Commercial-grade PoE system with high-definition 4K sensors and continuous recording. 100% zero monthly subscription fees.
            </p>

            <div class="border-t border-slate-200 dark:border-white/10 pt-4 space-y-3 text-sm sm:text-base text-slate-700 dark:text-slate-200 font-medium">
              <div class="flex items-start gap-2.5">
                <span class="text-blue-500 font-bold shrink-0 mt-0.5">✓</span>
                <span><strong>4 x Ultra HD</strong> Weatherproof Turret Cameras</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-blue-500 font-bold shrink-0 mt-0.5">✓</span>
                <span><strong>4-Channel 4K NVR</strong> with PoE Internal Switch</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-blue-500 font-bold shrink-0 mt-0.5">✓</span>
                <span><strong>2TB WD Purple</strong> Surveillance Hard Drive</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-blue-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>30m Smart Infrared Night Vision</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-blue-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>Concealed In-Roof Cat6 Cabling Allowance</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-blue-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>Mobile App Viewing on All Household Phones</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-blue-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>3-Year Hardware + 5-Year Workmanship Warranty</span>
              </div>
            </div>
          </div>

          <div class="pt-6">
            <button onclick="prefillQuote('Essential Wired 4K Package (From $1,690)', 'Home / Residential')" class="w-full py-4 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-black text-sm uppercase tracking-wider shadow-lg shadow-blue-600/30 transition-all">
              Request 4K Wired Quote &rarr;
            </button>
          </div>
        </div>

        <!-- Package 3: Active Deterrence Package -->
        <div class="glass-box p-8 rounded-3xl border border-slate-200 dark:border-white/10 flex flex-col justify-between">
          <div class="space-y-4">
            <span class="px-3 py-1 rounded-full bg-red-500/15 text-red-600 dark:text-red-400 text-xs font-black uppercase tracking-wider">
              Proactive Defense &amp; AI
            </span>
            <h3 class="text-2xl font-black text-slate-900 dark:text-white">Active Deterrence</h3>
            <div class="flex items-baseline gap-1">
              <span class="text-4xl font-black text-slate-900 dark:text-white">From $1,890</span>
              <span class="text-xs text-slate-500 dark:text-slate-400 font-bold">inc. GST</span>
            </div>
            <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
              Cameras that actively stop intruders before they enter. Equipped with flashing warning strobes, audible siren alarms, and AI human detection.
            </p>

            <div class="border-t border-slate-200 dark:border-white/10 pt-4 space-y-3 text-sm sm:text-base text-slate-600 dark:text-slate-300">
              <div class="flex items-start gap-2.5">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✓</span>
                <span><strong>4x 4K AI Smart Cameras</strong> with Siren &amp; Strobe</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✓</span>
                <span><strong>8-Channel 4K NVR</strong> (Expandable for future cameras)</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✓</span>
                <span><strong>2TB Surveillance Drive</strong></span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>ColorVu 24/7 Full-Color Night Vision</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>Two-Way Audio Talkback from Smartphone</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>AcuSense Human &amp; Vehicle Filtering</span>
              </div>
              <div class="flex items-start gap-2.5">
                <span class="text-red-500 font-bold shrink-0 mt-0.5">✓</span>
                <span>Priority Local After-Sales Support</span>
              </div>
            </div>
          </div>

          <div class="pt-6">
            <button onclick="prefillQuote('Active Deterrence Package (From $1,890)', 'Home / Residential')" class="w-full py-3.5 rounded-xl bg-slate-200 dark:bg-slate-800 hover:bg-blue-600 hover:text-white font-black text-sm uppercase tracking-wider text-slate-900 dark:text-white transition-all">
              Request Deterrence Quote &rarr;
            </button>
          </div>
        </div>

      </div>


      <!-- Pricing Assumptions Banner (Direct from wireframe) -->
      <div class="mt-8 p-4 rounded-2xl bg-slate-100 dark:bg-slate-800/80 border border-slate-200 dark:border-white/10 text-sm sm:text-base text-slate-600 dark:text-slate-300 text-center max-w-4xl mx-auto leading-relaxed">
        <strong>Price Assumptions:</strong> Packages assume standard single-storey tiled/tin roof pitch with internal crawl space access. Double-storey homes, split-levels, or custom cable pathways will receive a fast, free itemized quote after assessing cable routes.
      </div>

    </div>
  </section>
