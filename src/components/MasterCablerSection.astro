---
// Component: MasterCablerSection.astro
// "Don't Pay an Electrician to Hook Up Your System & Ethernet Cables"
// Positioned between TrustBadges (Licence strip) and FeaturedAwards (Queensland Customer Choice Winner).
---

<section class="py-16 lg:py-20 relative overflow-hidden bg-slate-50/50 dark:bg-slate-900/40 border-b border-slate-200 dark:border-white/10 transition-colors duration-300" id="master-cabler-hookup">
  <!-- Ambient Lighting Glows -->
  <div class="absolute top-12 left-1/4 w-[32rem] h-[32rem] bg-blue-600/10 dark:bg-blue-600/15 rounded-full blur-3xl pointer-events-none pulse-glow-anim"></div>
  <div class="absolute bottom-10 right-10 w-[30rem] h-[30rem] bg-cyan-500/10 dark:bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column on Desktop: Master Cabler & Rack Image Card (lg:col-span-5) -->
      <div class="lg:col-span-5 order-last lg:order-first">
        <div class="relative mx-auto max-w-md lg:max-w-none group">
          
          <!-- 1. 360-Degree 4-Side Ambient Glow Halo -->
          <div class="absolute -inset-2 bg-gradient-to-r from-cyan-500/35 via-blue-600/30 to-cyan-400/35 rounded-[30px] blur-xl opacity-75 group-hover:opacity-100 transition duration-700 pointer-events-none"></div>

          <!-- 2. Concentrated 4-Corner Glow Flares -->
          <div class="absolute -top-2.5 -left-2.5 w-24 h-24 bg-cyan-400/45 rounded-full blur-xl pointer-events-none"></div>
          <div class="absolute -top-2.5 -right-2.5 w-24 h-24 bg-blue-500/40 rounded-full blur-xl pointer-events-none"></div>
          <div class="absolute -bottom-2.5 -left-2.5 w-24 h-24 bg-blue-500/40 rounded-full blur-xl pointer-events-none"></div>
          <div class="absolute -bottom-2.5 -right-2.5 w-24 h-24 bg-cyan-400/45 rounded-full blur-xl pointer-events-none"></div>

          <!-- 3. Luminous 1.5px Outer Border with Perimeter Glow -->
          <div class="relative rounded-2xl sm:rounded-3xl p-[1.5px] bg-gradient-to-tr from-cyan-400 via-blue-500/60 to-cyan-300 shadow-[0_0_35px_rgba(6,182,212,0.4),0_15px_40px_rgba(0,0,0,0.6)] hover:shadow-[0_0_50px_rgba(6,182,212,0.55),0_20px_50px_rgba(0,0,0,0.7)] transition-all duration-500">
            
            <!-- Inner Image Container with Concentric Curvature -->
            <div class="relative rounded-[15px] sm:rounded-[22px] overflow-hidden aspect-[941/1304] bg-slate-950">
              <img 
                src="/cctv-slide2.jpg" 
                alt="Professional wall-mounted network server rack with immaculate blue Cat6 Ethernet cabling and NVR hookup" 
                class="w-full h-full object-cover object-center transform group-hover:scale-102 transition-transform duration-700"
                loading="lazy"
              />

              <!-- Top-Left Floating Badge: Installed Master Cabler -->
              <div class="absolute top-3.5 left-3.5 px-3 py-1.5 rounded-full bg-slate-950/85 backdrop-blur-md border border-white/20 text-white text-[11px] font-bold flex items-center gap-1.5 shadow-lg z-10">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Installed Master Cabler</span>
              </div>

              <!-- Bottom Floating Specs Strip -->
              <div class="absolute bottom-3.5 inset-x-3.5 p-3 sm:p-3.5 rounded-2xl bg-slate-950/90 backdrop-blur-md border border-white/15 text-white flex items-center justify-between shadow-2xl z-10">
                <div>
                  <div class="text-xs sm:text-sm font-black tracking-tight text-white flex items-center gap-1.5">
                    <span>Certified Master Cabler Installation</span>
                    <svg class="w-4 h-4 text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                  </div>
                  <p class="text-[11px] text-slate-300 mt-0.5">Professional Tidy Cat6 termination • Up to 50% lower cost</p>
                </div>
                <span class="px-2.5 py-1 rounded-lg text-[9px] font-black uppercase tracking-wider bg-blue-600/50 text-cyan-300 border border-cyan-400/50 shadow-sm text-center leading-tight">
                  Master Cabler<br/>Licensed
                </span>
              </div>

              <!-- Subtle Inner Specular Reflection Line -->
              <div class="absolute inset-0 rounded-[15px] sm:rounded-[22px] ring-1 ring-inset ring-white/15 pointer-events-none"></div>
            </div>

          </div>

        </div>
      </div>

      <!-- Right Column on Desktop: Content & Call-to-Actions (lg:col-span-7) -->
      <div class="lg:col-span-7 space-y-6 order-first lg:order-last">
        
        <!-- Top Badge -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/60 text-blue-700 dark:text-cyan-300 text-xs font-black uppercase tracking-wider shadow-sm">
          <span>⚡</span>
          <span>ACMA MASTER CABLER • QLD SECURITY PROVIDER • UP TO 50% SAVINGS</span>
        </div>

        <!-- Headline (Exact Client Requirement) -->
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.1]">
          You Don't Need an Electrician <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-cyan-500 to-blue-700">for IP Camera Systems.</span>
        </h2>

        <!-- Lead Paragraph (Exact Client Requirement) -->
        <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl">
          IP security cameras run on low-voltage 48V Power-over-Ethernet (PoE), not 240V mains power. As a licensed ACMA Master Cabler &amp; IT Tech, I handle the professional data cabling and the complete NVR network and app setup &ndash; often for half the cost of a general electrician.
        </p>

        <!-- Bullet Points (Exact Client Requirement) -->
        <div class="space-y-2.5 pt-1 text-sm sm:text-base text-slate-700 dark:text-slate-200 font-bold">
          <div class="flex items-center gap-2.5">
            <span class="text-blue-600 dark:text-cyan-400 font-extrabold text-base">✓</span>
            <span>Licensed ACRS Master Cabler &amp; QLD Security Installer</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-blue-600 dark:text-cyan-400 font-extrabold text-base">✓</span>
            <span>Complete Network &amp; Smartphone App Configuration</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-blue-600 dark:text-cyan-400 font-extrabold text-base">✓</span>
            <span>Specialized in Low-Voltage PoE Data Cabling</span>
          </div>
          <div class="flex items-center gap-2.5">
            <span class="text-blue-600 dark:text-cyan-400 font-extrabold text-base">✓</span>
            <span>Up to 50% Savings over general rates</span>
          </div>
        </div>

        <!-- Button Row -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a href="#quote" class="px-8 py-4 rounded-2xl bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-black text-xs uppercase tracking-wider shadow-xl shadow-blue-600/30 inline-flex items-center gap-2.5 transform hover:-translate-y-0.5 transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Request a CCTV Quote
          </a>

          <a href="#pricing" class="px-7 py-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-white/15 text-slate-800 dark:text-white hover:border-blue-500 font-black text-xs uppercase tracking-wider shadow-sm transition-all inline-flex items-center gap-2">
            <span>View Packages</span>
            <span class="text-blue-500">&darr;</span>
          </a>
        </div>

        <!-- Rapid Suburb Tag Pills -->
        <div class="pt-4 border-t border-slate-200 dark:border-white/10 space-y-2">
          <div class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Quick Suburb Availability Check:
          </div>
          <div class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm font-bold">
            <button onclick="selectSuburbForQuote('Carindale (4152)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Carindale</button>
            <button onclick="selectSuburbForQuote('Carina (4152)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Carina</button>
            <button onclick="selectSuburbForQuote('Carina Heights (4152)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Carina Heights</button>
            <button onclick="selectSuburbForQuote('Belmont (4153)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Belmont</button>
            <button onclick="selectSuburbForQuote('Mansfield (4122)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Mansfield</button>
            <button onclick="selectSuburbForQuote('Camp Hill (4152)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Camp Hill</button>
          </div>
        </div>

      </div>

    </div>
  </div>
</section>
