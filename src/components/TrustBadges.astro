---
// Component: TrustBadges.astro
---
<!-- 3. TRUST STRIP (WIREFRAME BLOCK 3 - 4 METALLIC CHIPS) -->
  <section class="py-6 bg-slate-100 dark:bg-slate-900/70 border-y border-slate-200 dark:border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-3 sm:gap-5 text-center">
        
        <!-- Chip 1 -->
        <div class="glass-box p-4 sm:p-5 rounded-2xl flex items-center gap-3 text-left">
          <div class="w-10 h-10 rounded-xl bg-blue-600/15 text-blue-600 dark:text-blue-400 flex items-center justify-center text-xl shrink-0">
            🛡️
          </div>
          <div>
            <div class="font-black text-sm sm:text-base text-slate-900 dark:text-white">QLD Security Installer Licence</div>
            <div class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">Class 1 &amp; 2 Installer Licenced</div>
          </div>
        </div>

        <!-- Chip 2 -->
        <div class="glass-box p-4 sm:p-5 rounded-2xl flex items-center gap-3 text-left">
          <div class="w-10 h-10 rounded-xl bg-cyan-600/15 text-cyan-600 dark:text-cyan-400 flex items-center justify-center text-xl shrink-0">
            ⚡
          </div>
          <div>
            <div class="font-black text-sm sm:text-base text-slate-900 dark:text-white">Registered Cabler</div>
            <div class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">ACMA Open Cat6 Certified</div>
          </div>
        </div>

        <!-- Chip 3 -->
        <div class="glass-box p-4 sm:p-5 rounded-2xl flex items-center gap-3 text-left">
          <div class="w-10 h-10 rounded-xl bg-emerald-600/15 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xl shrink-0">
            📜
          </div>
          <div>
            <div class="font-black text-sm sm:text-base text-slate-900 dark:text-white">Fully Insured</div>
            <div class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">$20M Public Liability Cover</div>
          </div>
        </div>

        <!-- Chip 4 -->
        <div class="glass-box p-4 sm:p-5 rounded-2xl flex items-center gap-3 text-left">
          <div class="w-10 h-10 rounded-xl bg-amber-600/15 text-amber-600 dark:text-amber-400 flex items-center justify-center text-xl shrink-0">
            ✍️
          </div>
          <div>
            <div class="font-black text-sm sm:text-base text-slate-900 dark:text-white">Written Workmanship Warranty</div>
            <div class="text-xs sm:text-sm text-slate-500 dark:text-slate-400">5-Year Workmanship Terms</div>
          </div>
        </div>

      </div>
    </div>
  </section>
