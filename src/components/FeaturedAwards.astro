---
// Component: FeaturedAwards.astro
// Highlights the top 4 most recent Word of Mouth (WOM) Service Award badges (2026, 2025, 2024, 2023)
// Positioned between TrustBadges (Licences) and ServicesGrid (Professional Security Services).
// Fully optimized for both Light and Dark theme modes.

const topAwards = [
  {
    year: '2026',
    svg: '/2026%20Service%20Award.svg',
    tag: 'LATEST WINNER',
    tagColor: 'bg-amber-50 dark:bg-amber-500/20 text-amber-700 dark:text-amber-300 border-amber-300 dark:border-amber-400/50',
    halo: 'from-amber-400/20 via-yellow-400/20 to-amber-500/20 dark:from-amber-500/30 dark:to-yellow-400/20',
    borderColor: 'border-amber-400/80 dark:border-amber-400/60',
    highlight: true
  },
  {
    year: '2025',
    svg: '/2025%20Service%20Award.svg',
    tag: 'ANNUAL EXCELLENCE',
    tagColor: 'bg-cyan-50 dark:bg-cyan-500/20 text-cyan-800 dark:text-cyan-300 border-cyan-300 dark:border-cyan-400/50',
    halo: 'from-cyan-400/20 via-blue-400/15 to-cyan-500/20 dark:from-cyan-500/25 dark:to-blue-400/20',
    borderColor: 'border-cyan-500/70 dark:border-cyan-400/50',
    highlight: true
  },
  {
    year: '2024',
    svg: '/2024%20Service%20Award.svg',
    tag: 'SERVICE WINNER',
    tagColor: 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-white/10',
    halo: '',
    borderColor: 'border-slate-200 dark:border-white/10 hover:border-amber-400/60',
    highlight: false
  },
  {
    year: '2023',
    svg: '/2023%20Service%20Award.svg',
    tag: 'SERVICE WINNER',
    tagColor: 'bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border-slate-200 dark:border-white/10',
    halo: '',
    borderColor: 'border-slate-200 dark:border-white/10 hover:border-amber-400/60',
    highlight: false
  }
];
---

<section class="py-10 sm:py-12 bg-slate-100/90 dark:bg-gradient-to-b dark:from-slate-950 dark:via-slate-900/60 dark:to-slate-950 border-b border-slate-200 dark:border-white/10 relative overflow-hidden transition-colors duration-300">
  <!-- Subtle Backlight Glow -->
  <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3/4 h-32 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header Strip -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-8 pb-4 border-b border-slate-200 dark:border-white/10 text-center md:text-left">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-700 dark:text-amber-400 text-xs font-black uppercase tracking-wider mb-2 shadow-sm">
          <span class="text-amber-500 dark:text-amber-300">★</span>
          <span>Queensland Customer Choice Winner</span>
          <span class="text-amber-500 dark:text-amber-300">★</span>
        </div>
        <h3 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight">
          Recent Word of Mouth (WOM) Service Awards
        </h3>
        <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 mt-1">
          Independently verified 5-star customer feedback across Carindale and Brisbane East.
        </p>
      </div>

      <!-- Quick Link to Full 13-Year Archive -->
      <a 
        href="#wom-awards" 
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white dark:bg-slate-900/80 hover:bg-slate-50 dark:hover:bg-slate-800 border border-slate-300 dark:border-white/15 text-xs font-bold text-slate-700 dark:text-slate-300 hover:text-slate-900 dark:hover:text-white transition-all group shrink-0 shadow-sm"
      >
        <span>View all 13 annual awards (2014–2026)</span>
        <span class="text-amber-500 dark:text-amber-400 group-hover:translate-y-0.5 transition-transform">&darr;</span>
      </a>
    </div>

    <!-- Top 4 Badges Grid -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
      {topAwards.map((award) => (
        <div class="relative group">
          <!-- Ambient Glow for recent winners -->
          {award.highlight && (
            <div class={`absolute -inset-0.5 bg-gradient-to-r ${award.halo} rounded-3xl blur group-hover:blur-md transition-all duration-300`}></div>
          )}
          
          <div class={`relative rounded-2xl sm:rounded-3xl p-5 sm:p-6 bg-white dark:bg-slate-900/90 border ${award.borderColor} shadow-lg shadow-slate-200/60 dark:shadow-xl flex flex-col items-center text-center justify-between h-full transition-all duration-300 group-hover:-translate-y-1`}>
            
            <!-- Tag Pill -->
            <div class={`inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full border text-[10px] font-black uppercase tracking-wider mb-3 ${award.tagColor}`}>
              {award.year === '2026' && <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>}
              <span>{award.tag}</span>
            </div>

            <!-- Official SVG Badge Graphic -->
            <div class="relative w-24 h-24 sm:w-28 sm:h-28 flex items-center justify-center my-1">
              <img 
                src={award.svg} 
                alt={`Word of Mouth ${award.year} Service Award Winner`} 
                class="w-full h-full object-contain drop-shadow-md group-hover:scale-105 transition-transform duration-300"
                loading="eager"
              />
            </div>

            <!-- Year Title & Star Rating -->
            <div class="mt-3">
              <div class="text-lg sm:text-xl font-black text-slate-900 dark:text-white tracking-tight">
                {award.year} Award
              </div>
              <div class="text-amber-500 dark:text-amber-400 text-xs mt-0.5 flex items-center justify-center gap-0.5">
                <span>★</span><span>★</span><span>★</span><span>★</span><span>★</span>
              </div>
              <div class="text-[11px] text-slate-600 dark:text-slate-400 font-semibold mt-1">
                {award.year === '2026' ? 'Carindale Top Choice' : award.year === '2025' ? '5-Star Satisfaction' : 'Verified Workmanship'}
              </div>
            </div>

          </div>
        </div>
      ))}
    </div>

  </div>
</section>
