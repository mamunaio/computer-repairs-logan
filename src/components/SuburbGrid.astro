        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Holland Park (4121)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Holland Park</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4121 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Wishart (4122)')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Wishart</div>
          <div class="text-xs text-emerald-600 dark:text-emerald-400 font-bold">4122 • Covered</div>
        </div>

        <div class="suburb-pill glass-box p-3.5 rounded-2xl cursor-pointer hover:border-blue-500 transition-all" onclick="selectSuburbForQuote('Brisbane East Region')">
          <div class="font-bold text-sm sm:text-base text-slate-900 dark:text-white">Brisbane East</div>
          <div class="text-xs text-blue-600 dark:text-blue-400 font-bold">All Suburbs</div>
        </div>

      </div>

    </div>
  </section>
