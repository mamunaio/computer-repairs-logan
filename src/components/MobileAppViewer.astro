---
// Component: MobileAppViewer.astro
// Relocated Interactive Mobile CCTV Surveillance HUD & Remote Monitoring Showcase
---

<section id="remote-viewing" class="py-20 relative overflow-hidden bg-slate-100/70 dark:bg-slate-900/50 border-y border-slate-200 dark:border-white/10 scroll-mt-24">
  <!-- Subtle Background Ambient Glows -->
  <div class="absolute top-1/4 -left-20 w-96 h-96 bg-blue-600/10 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-10 -right-20 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="text-xs font-black text-blue-600 dark:text-blue-400 uppercase tracking-widest px-3.5 py-1 rounded-full bg-blue-50 dark:bg-blue-950/50 border border-blue-200 dark:border-blue-800/50">
        Live Mobile App &amp; Remote Viewing
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white mt-3 tracking-tight">
        Interactive Smartphone CCTV Monitoring
      </h2>
      <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base mt-2 leading-relaxed">
        Test our live camera viewer below. Switch channels and toggle 4K Day vs ColorVu Night Vision to experience the real clarity delivered to your phone.
      </p>
    </div>

    <!-- Main 2-Column Showcase Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Feature Highlights & Benefits (lg:col-span-5) -->
      <div class="lg:col-span-5 space-y-6">
        
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-600 dark:text-emerald-400 text-xs font-black uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-ping"></span>
          <span>Zero Monthly Subscription Fees • $0 Cloud Bills</span>
        </div>

        <h3 class="text-2xl sm:text-3xl font-black text-slate-900 dark:text-white tracking-tight leading-tight">
          Total Perimeter Awareness Right from Your Pocket
        </h3>

        <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed">
          Every camera system we install in Carindale includes complete mobile app setup on all household phones and tablets. Watch crystal-clear live streams, receive instant push notifications, and retrieve recorded incident video in seconds.
        </p>

        <!-- Feature List -->
        <div class="space-y-4 pt-2">
          
          <div class="glass-box p-4 rounded-2xl border border-slate-200 dark:border-white/10 flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-blue-600/10 text-blue-600 dark:text-blue-400 flex items-center justify-center text-lg shrink-0 mt-0.5">
              🔔
            </div>
            <div>
              <h4 class="font-extrabold text-sm sm:text-base text-slate-900 dark:text-white">Smart AI Push Alerts</h4>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">
                Human and vehicle target classification filters out spiderwebs, rain, and headlights so you only get alerted when it truly matters.
              </p>
            </div>
          </div>

          <div class="glass-box p-4 rounded-2xl border border-slate-200 dark:border-white/10 flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-cyan-600/10 text-cyan-600 dark:text-cyan-400 flex items-center justify-center text-lg shrink-0 mt-0.5">
              🔒
            </div>
            <div>
              <h4 class="font-extrabold text-sm sm:text-base text-slate-900 dark:text-white">Encrypted Direct P2P Access</h4>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">
                Bank-grade encrypted connection directly to your home NVR. No middleman servers watching your private family feeds.
              </p>
            </div>
          </div>

          <div class="glass-box p-4 rounded-2xl border border-slate-200 dark:border-white/10 flex items-start gap-3.5">
            <div class="w-10 h-10 rounded-xl bg-amber-600/10 text-amber-600 dark:text-amber-400 flex items-center justify-center text-lg shrink-0 mt-0.5">
              📱
            </div>
            <div>
              <h4 class="font-extrabold text-sm sm:text-base text-slate-900 dark:text-white">Multi-Device &amp; Family Accounts</h4>
              <p class="text-xs sm:text-sm text-slate-500 dark:text-slate-400 mt-0.5">
                Works seamlessly on iPhone, iPad, Android, Apple Watch, and PC/Mac client software with customizable permission tiers.
              </p>
            </div>
          </div>

        </div>

        <!-- CTA & Phone Hotline -->
        <div class="pt-2 flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
          <a href="#quote" onclick="prefillQuote('Remote Viewing Setup & Mobile App', 'Home / Residential')" class="px-6 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white text-center font-black text-xs uppercase tracking-wider shadow-lg shadow-blue-600/25 transition-all">
            Get Free App Setup With Quote &rarr;
          </a>
          <a href="tel:0731000000" class="px-5 py-3.5 rounded-xl bg-slate-200 dark:bg-slate-800 hover:bg-slate-300 dark:hover:bg-slate-700 text-slate-800 dark:text-slate-200 text-center font-bold text-xs flex items-center justify-center gap-2 transition-all">
            <span>📞 (07) 3100 0000</span>
          </a>
        </div>

      </div>

      <!-- Right Column: Interactive Mobile App / CCTV HUD Mockup (lg:col-span-7) -->
      <div class="lg:col-span-7">
        <div class="relative mx-auto max-w-lg lg:max-w-xl">
          
          <!-- Outer Ambient Glow -->
          <div class="absolute -inset-2 bg-gradient-to-r from-cyan-500/30 via-blue-600/25 to-cyan-400/30 rounded-[36px] blur-xl opacity-80 pointer-events-none"></div>

          <!-- Smartphone / Tablet Frame Container -->
          <div class="relative rounded-[32px] p-3 sm:p-4 bg-slate-950 border-2 border-slate-800 shadow-[0_20px_50px_rgba(0,0,0,0.7)]">
            
            <!-- Phone Top Bezel & Speaker -->
            <div class="flex items-center justify-between px-4 pb-2.5 text-[11px] font-mono text-slate-400 border-b border-white/10">
              <div class="flex items-center gap-2">
                <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
                <span class="font-bold text-white tracking-wider">CCTV GUARD PRO</span>
              </div>
              <!-- Phone Speaker Notch -->
              <div class="w-16 h-1.5 rounded-full bg-slate-800 hidden sm:block"></div>
              <div class="flex items-center gap-2 font-bold text-cyan-400">
                <span>5G ULTRA</span>
                <span>100% 🔋</span>
              </div>
            </div>

            <!-- OSD Live Status Header -->
            <div class="mt-2.5 px-3 py-2 rounded-t-xl bg-slate-900/90 border border-white/10 flex flex-wrap items-center justify-between gap-2 text-xs">
              <div class="flex items-center gap-2 min-w-0">
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-red-600 text-white font-mono font-black text-[10px] tracking-wider animate-pulse">
                  ● REC
                </span>
                <span id="cam-active-title" class="font-black text-white text-xs truncate">
                  CAM 01 • DRIVEWAY &amp; FRONT ENTRY
                </span>
              </div>
              <div class="flex items-center gap-2 text-[11px] font-mono">
                <span id="cctv-live-clock" class="text-cyan-300 font-bold">2026-09-15 02:15:00</span>
              </div>
            </div>

            <!-- Central Video Stage Screen -->
            <div 
              id="cctv-preview-screen" 
              class="relative aspect-[16/10] sm:aspect-[16/9.5] w-full bg-slate-950 bg-cover bg-center overflow-hidden border-x border-b border-white/10 flex flex-col justify-between p-3 select-none"
              style="background-image: linear-gradient(rgba(15, 23, 42, 0.08), rgba(15, 23, 42, 0.35)), url('/cctv-ch1-day.jpg');"
            >
              <!-- Scanline Overlay -->
              <div class="absolute inset-0 cctv-scanline pointer-events-none"></div>

              <!-- Top Stream Metadata Overlay -->
              <div class="relative z-10 flex items-center justify-between text-[10px] sm:text-[11px] font-mono text-white bg-black/60 backdrop-blur-md px-2.5 py-1 rounded-lg border border-white/10">
                <span class="text-emerald-400 font-bold">4K UHD • 3840×2160 • 30 FPS</span>
                <span id="ai-detection-label" class="px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 font-bold">
                  AI ACUSENSE: VEHICLE
                </span>
              </div>

              <!-- AI Bounding Reticle Box -->
              <div class="relative z-10 my-auto text-center pointer-events-none">
                <div id="cctv-target-box" class="w-40 sm:w-48 h-28 sm:h-32 border-2 border-dashed border-cyan-400 rounded-lg mx-auto relative flex flex-col justify-between p-1 bg-cyan-400/10 backdrop-blur-[1px] transition-all">
                  <div class="flex justify-between text-[8px] sm:text-[9px] font-mono font-bold text-cyan-300">
                    <span>98.4% CONF</span>
                    <span>TARGET: VEHICLE</span>
                  </div>
                  <div class="text-[9px] sm:text-[10px] font-mono font-black text-cyan-200 uppercase bg-black/75 px-2 py-0.5 rounded mx-auto border border-cyan-400/30">
                    Front Driveway Zone
                  </div>
                </div>
              </div>

              <!-- Bottom OSD Info Bar -->
              <div class="relative z-10 flex items-center justify-between text-[10px] sm:text-[11px] font-mono text-slate-300 bg-black/65 backdrop-blur-md px-2.5 py-1.5 rounded-lg border border-white/10">
                <span class="text-slate-300">STORAGE: 3.2TB / 4TB (28 Days)</span>
                <span id="vision-mode-indicator" class="text-amber-400 font-bold">MODE: DAY 4K HDR</span>
              </div>
            </div>

            <!-- Multi-Camera Channel Switcher Buttons -->
            <div class="bg-slate-900/95 px-3 py-2.5 border-x border-b border-white/10 flex flex-col sm:flex-row items-center justify-between gap-2 text-xs font-mono font-bold">
              <span class="text-slate-400 text-[10px] tracking-wider uppercase">SWITCH CHANNEL:</span>
              <div class="grid grid-cols-4 gap-1.5 w-full sm:w-auto">
                <button 
                  type="button"
                  onclick="switchCamera(1, 'CAM 01 • DRIVEWAY & FRONT ENTRY', 'AI ACUSENSE: VEHICLE')" 
                  id="cam-btn-1" 
                  class="px-2.5 py-1.5 rounded-lg bg-blue-600 text-white transition-all text-center text-[11px] font-mono font-bold shadow-sm cursor-pointer"
                >
                  CH 1
                </button>
                <button 
                  type="button"
                  onclick="switchCamera(2, 'CAM 02 • PORCH & PACKAGE DROP', 'FACIAL DETECTION: RECOGNISED')" 
                  id="cam-btn-2" 
                  class="px-2.5 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white transition-all text-center text-[11px] font-mono font-bold cursor-pointer"
                >
                  CH 2
                </button>
                <button 
                  type="button"
                  onclick="switchCamera(3, 'CAM 03 • SIDE PASSAGEWAY', 'PERIMETER LINE CROSS')" 
                  id="cam-btn-3" 
                  class="px-2.5 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white transition-all text-center text-[11px] font-mono font-bold cursor-pointer"
                >
                  CH 3
                </button>
                <button 
                  type="button"
                  onclick="switchCamera(4, 'CAM 04 • REAR ENTERTAINING', 'MOTION: PATIO CLEAR')" 
                  id="cam-btn-4" 
                  class="px-2.5 py-1.5 rounded-lg bg-slate-800 text-slate-400 hover:text-white transition-all text-center text-[11px] font-mono font-bold cursor-pointer"
                >
                  CH 4
                </button>
              </div>
            </div>

            <!-- Day / ColorVu Night Vision Mode Controls -->
            <div class="bg-slate-950 p-3 sm:p-3.5 rounded-b-2xl border-x border-b border-white/10 flex items-center justify-between gap-3">
              <div class="text-xs">
                <div class="font-black text-white flex items-center gap-1.5">
                  <span>Night Vision Demo:</span>
                  <span class="text-[10px] text-cyan-400 font-bold">Try ColorVu</span>
                </div>
                <div class="text-[11px] text-slate-400">See real F1.0 low-light full-color clarity</div>
              </div>

              <div class="flex items-center gap-1 bg-slate-900 p-1 rounded-xl border border-white/10">
                <button 
                  type="button"
                  id="btn-day" 
                  onclick="setCctvVision('day')" 
                  class="px-3 py-1.5 rounded-lg text-xs font-bold bg-blue-600 text-white transition-all cursor-pointer shadow-sm"
                >
                  ☀️ Day HDR
                </button>
                <button 
                  type="button"
                  id="btn-night" 
                  onclick="setCctvVision('night')" 
                  class="px-3 py-1.5 rounded-lg text-xs font-bold text-slate-400 hover:text-white transition-all cursor-pointer"
                >
                  🌙 ColorVu
                </button>
              </div>
            </div>

            <!-- App Simulated Action Toolbar -->
            <div class="mt-2.5 pt-2 flex items-center justify-around text-slate-400 text-xs border-t border-white/10">
              <span class="flex items-center gap-1 hover:text-white cursor-pointer transition-colors">📸 Snapshot</span>
              <span class="flex items-center gap-1 hover:text-white cursor-pointer transition-colors">🎥 Clip Record</span>
              <span class="flex items-center gap-1 hover:text-white cursor-pointer transition-colors">🔊 Two-Way Talk</span>
              <span class="flex items-center gap-1 text-red-400 hover:text-red-300 cursor-pointer transition-colors">🚨 Siren Alert</span>
            </div>

          </div>

        </div>
      </div>

    </div>

  </div>
</section>
