  <script>
    // Hero Section Slider (Full Section Cross-Fade Carousel with Dots)
    function initHeroSectionSlider() {
      const section = document.getElementById('hero-section-slider');
      if (!section) return;

      const slides = section.querySelectorAll('.hero-slide');
      const dots = section.querySelectorAll('.hero-dot');
      if (slides.length < 2 || dots.length < 2) return;

      let currentIndex = 0;
      let timer: any = null;
      const intervalMs = 5000; // Auto-play every 5 seconds

      function setSlide(index: number) {
        currentIndex = (index + slides.length) % slides.length;

        // Cross-fade the slides
        slides.forEach((slide, i) => {
          if (i === currentIndex) {
            slide.classList.remove('opacity-0', 'z-0', 'pointer-events-none', 'absolute', 'inset-0');
            slide.classList.add('opacity-100', 'z-10', 'relative', 'pointer-events-auto');
          } else {
            slide.classList.remove('opacity-100', 'z-10', 'relative', 'pointer-events-auto');
            slide.classList.add('opacity-0', 'z-0', 'pointer-events-none', 'absolute', 'inset-0');
          }
        });

        // Update dot indicator styles
        dots.forEach((dot, i) => {
          const bar = dot.querySelector('span');
          if (!bar) return;
          if (i === currentIndex) {
            bar.className = 'block w-3 h-3 rounded-full transition-all duration-300 bg-gradient-to-r from-cyan-400 to-blue-500 shadow-[0_0_10px_rgba(6,182,212,0.9)] ring-2 ring-cyan-400/50 scale-110';
          } else {
            bar.className = 'block w-3 h-3 rounded-full transition-all duration-300 bg-slate-400/50 dark:bg-slate-700 group-hover:bg-slate-400';
          }
        });
      }

      function startAutoPlay() {
        stopAutoPlay();
        timer = setInterval(() => {
          setSlide(currentIndex + 1);
        }, intervalMs);
      }

      function stopAutoPlay() {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      }

      // Dot click handling
      dots.forEach((dot) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          const targetIndex = parseInt(dot.getAttribute('data-index') || '0', 10);
          setSlide(targetIndex);
          startAutoPlay();
        });
      });

      // Pause auto-play on mouse enter, resume on mouse leave
      section.addEventListener('mouseenter', stopAutoPlay);
      section.addEventListener('mouseleave', startAutoPlay);

      // Touch swipe support
      let touchStartX = 0;
      let touchEndX = 0;

      section.addEventListener('touchstart', (e: TouchEvent) => {
        touchStartX = e.changedTouches[0].screenX;
        stopAutoPlay();
      }, { passive: true });

      section.addEventListener('touchend', (e: TouchEvent) => {
        touchEndX = e.changedTouches[0].screenX;
        const diffX = touchEndX - touchStartX;
        if (Math.abs(diffX) > 50) {
          if (diffX < 0) {
            setSlide(currentIndex + 1); // Swipe left
          } else {
            setSlide(currentIndex - 1); // Swipe right
          }
        }
        startAutoPlay();
      }, { passive: true });

      startAutoPlay();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initHeroSectionSlider);
    } else {
      initHeroSectionSlider();
    }
    document.addEventListener('astro:page-load', initHeroSectionSlider);
  </script>
