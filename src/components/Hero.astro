---
// Component: Hero.astro (Single Static Hero Section - 100% Approved Design)
---
<!-- 2. ABOVE THE FOLD / HERO SECTION (WIREFRAME BLOCK 2) -->
<section class="relative pt-10 pb-20 lg:pt-14 lg:pb-24 overflow-hidden" id="hero-section">
  <!-- Ambient Lighting Glows -->
  <div class="absolute top-12 right-1/4 w-[32rem] h-[32rem] bg-blue-600/10 dark:bg-blue-600/15 rounded-full blur-3xl pointer-events-none pulse-glow-anim"></div>
  <div class="absolute bottom-10 left-10 w-[30rem] h-[30rem] bg-cyan-500/10 dark:bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Hero Left Column -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Dispatch Live Ticker -->
        <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-blue-50 dark:bg-blue-950/60 border border-blue-200 dark:border-blue-800/60 text-blue-700 dark:text-blue-300 text-xs font-black uppercase tracking-wider shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-ping"></span>
          <span>🟢 ON-DUTY IN CARINDALE (4152) • $0 SITE ASSESSMENTS</span>
        </div>

        <!-- Strict Wireframe H1 -->
        <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black tracking-tight text-slate-900 dark:text-white leading-[1.08]">
          CCTV &amp; Security Camera Installation in <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 via-cyan-500 to-blue-700">Carindale</span>
        </h1>

        <!-- Strict Wireframe Lead Paragraph -->
        <p class="text-slate-600 dark:text-slate-300 text-base sm:text-lg leading-relaxed max-w-2xl">
          Professionally installed camera systems for local homes and businesses, with tidy cabling, clear night footage, mobile viewing and practical after-installation support.
        </p>

        <!-- Button Row -->
        <div class="pt-2 flex flex-wrap items-center gap-4">
          <a href="#quote" class="px-8 py-4 rounded-2xl bg-gradient-to-r from-blue-600 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-black text-xs uppercase tracking-wider shadow-xl shadow-blue-600/30 inline-flex items-center gap-2.5 transform hover:-translate-y-0.5 transition-all">
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            Request a CCTV Quote
          </a>

          <a href="#pricing" class="px-7 py-4 rounded-2xl bg-white dark:bg-slate-800 border border-slate-300 dark:border-white/15 text-slate-800 dark:text-white hover:border-blue-500 font-black text-xs uppercase tracking-wider shadow-sm transition-all inline-flex items-center gap-2">
            <span>View Packages</span>
            <span class="text-blue-500">&darr;</span>
          </a>
        </div>

        <!-- Rapid Suburb Tag Pills -->
        <div class="pt-4 border-t border-slate-200 dark:border-white/10 space-y-2">
          <div class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-slate-500 dark:text-slate-400">
            Quick Suburb Availability Check:
          </div>
          <div class="flex flex-wrap items-center gap-1.5 text-xs sm:text-sm font-bold">
            <button onclick="selectSuburbForQuote('Carindale (4152)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Carindale</button>
            <button onclick="selectSuburbForQuote('Carina (4152)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Carina</button>
            <button onclick="selectSuburbForQuote('Carina Heights (4152)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Carina Heights</button>
            <button onclick="selectSuburbForQuote('Belmont (4153)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Belmont</button>
            <button onclick="selectSuburbForQuote('Mansfield (4122)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Mansfield</button>
            <button onclick="selectSuburbForQuote('Camp Hill (4152)')" class="px-2.5 py-1 rounded-lg bg-slate-100 dark:bg-slate-800 hover:bg-blue-500 hover:text-white transition-all text-slate-700 dark:text-slate-300 cursor-pointer">Camp Hill</button>
          </div>
        </div>

      </div>

      <!-- Hero Right Column: Camera Image Card (100% Unclipped Full View) -->
      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-md lg:max-w-none group">
          
          <!-- 1. 360-Degree 4-Side Ambient Glow Halo -->
          <div class="absolute -inset-2 bg-gradient-to-r from-cyan-500/35 via-blue-600/30 to-cyan-400/35 rounded-[30px] blur-xl opacity-75 group-hover:opacity-100 transition duration-700 pointer-events-none"></div>

          <!-- 2. Concentrated 4-Corner Glow Flares -->
          <div class="absolute -top-2.5 -left-2.5 w-24 h-24 bg-cyan-400/45 rounded-full blur-xl pointer-events-none"></div>
          <div class="absolute -top-2.5 -right-2.5 w-24 h-24 bg-blue-500/40 rounded-full blur-xl pointer-events-none"></div>
          <div class="absolute -bottom-2.5 -left-2.5 w-24 h-24 bg-blue-500/40 rounded-full blur-xl pointer-events-none"></div>
          <div class="absolute -bottom-2.5 -right-2.5 w-24 h-24 bg-cyan-400/45 rounded-full blur-xl pointer-events-none"></div>

          <!-- 3. Luminous 1.5px Outer Border with Perimeter Glow -->
          <div class="relative rounded-2xl sm:rounded-3xl p-[1.5px] bg-gradient-to-tr from-cyan-400 via-blue-500/60 to-cyan-300 shadow-[0_0_35px_rgba(6,182,212,0.4),0_15px_40px_rgba(0,0,0,0.6)] hover:shadow-[0_0_50px_rgba(6,182,212,0.55),0_20px_50px_rgba(0,0,0,0.7)] transition-all duration-500">
            
            <!-- Inner Image Container with Harmonious Symmetrical Aspect Ratio -->
            <div class="relative rounded-[15px] sm:rounded-[22px] overflow-hidden aspect-[941/1304] bg-slate-950">
              <img 
                src="/3-brands-in-a-single-shot.png" 
                alt="Dahua, Hikvision, and HiLook 4K security cameras professionally installed on Carindale home at night" 
                class="w-full h-full object-cover object-top transform group-hover:scale-102 transition-transform duration-700"
                loading="eager"
              />

              <!-- Subtle Inner Specular Reflection Line -->
              <div class="absolute inset-0 rounded-[15px] sm:rounded-[22px] ring-1 ring-inset ring-white/15 pointer-events-none"></div>
            </div>

          </div>

        </div>
      </div>

    </div>
  </div>
</section>
