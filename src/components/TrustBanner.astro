---
// Component: TrustBanner.astro
// High-Contrast Master Cabler Trust & Price Advantage Banner above Pricing
// Fully optimized for both Light and Dark theme modes with high contrast.
---

<section id="master-cabler-trust" class="py-12 sm:py-16 relative overflow-hidden bg-slate-100/80 dark:bg-slate-950 border-y-2 border-blue-500/30 dark:border-blue-500/40 shadow-sm dark:shadow-2xl transition-colors duration-300">
  <!-- Dynamic Ambient Backlighting -->
  <div class="absolute -top-24 left-1/3 w-[36rem] h-[36rem] bg-blue-600/10 dark:bg-blue-600/20 rounded-full blur-3xl pointer-events-none pulse-glow-anim"></div>
  <div class="absolute -bottom-24 right-10 w-96 h-96 bg-cyan-500/10 dark:bg-cyan-500/15 rounded-full blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="relative rounded-3xl p-6 sm:p-10 lg:p-12 bg-gradient-to-br from-blue-50/90 via-white to-cyan-50/70 dark:from-slate-900/90 dark:via-slate-950 dark:to-blue-950/70 border-2 border-blue-300/60 dark:border-blue-500/30 backdrop-blur-xl shadow-xl shadow-blue-500/5 dark:shadow-[0_15px_40px_rgba(0,0,0,0.7)] transition-all duration-300">
      
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- Left / Primary Content Column (lg:col-span-8) -->
        <div class="lg:col-span-8 space-y-6">
          
          <!-- Dispatch & Verification Pill -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-blue-500/10 dark:bg-blue-500/15 border border-blue-500/30 dark:border-blue-400/40 text-blue-700 dark:text-cyan-300 text-xs font-black uppercase tracking-wider shadow-sm">
            <span class="w-2.5 h-2.5 rounded-full bg-blue-600 dark:bg-cyan-400 animate-ping"></span>
            <span>⚡ ACMA OPEN REGISTERED CABLER • 1/2 ELECTRICIAN RATES</span>
          </div>

          <!-- Strict Mandatory Headline (Exact Text) -->
          <h2 class="text-2xl sm:text-4xl lg:text-5xl font-black text-slate-900 dark:text-white tracking-tight leading-[1.15]">
            Don't pay for an Electrician to hook up your System and Ethernet Cables - We are 1/2 the price and we are an Installed Master Cabler
          </h2>

          <p class="text-slate-600 dark:text-slate-300 text-sm sm:text-base leading-relaxed max-w-2xl">
            General electricians typically charge premium $120–$180/hr rates for data work and rarely optimize NVR video streams. As dedicated ACMA Open Master Cablers, we specialize strictly in low-voltage communications, Cat6 data cabling, and CCTV systems — giving you immaculate, certified installations at a fraction of the cost.
          </p>

          <!-- 4-Grid Core Value Chips -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2">
            
            <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-white/10 shadow-sm dark:shadow-none transition-all">
              <span class="text-emerald-600 dark:text-emerald-400 font-bold text-base shrink-0">✓</span>
              <div class="text-xs sm:text-sm">
                <strong class="text-slate-900 dark:text-white block font-extrabold">1/2 The Cost of Electricians</strong>
                <span class="text-slate-600 dark:text-slate-400">Fixed upfront trade rates with no surprise travel fees.</span>
              </div>
            </div>

            <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-white/10 shadow-sm dark:shadow-none transition-all">
              <span class="text-blue-600 dark:text-cyan-400 font-bold text-base shrink-0">✓</span>
              <div class="text-xs sm:text-sm">
                <strong class="text-slate-900 dark:text-white block font-extrabold">ACMA Open Registered Cabler</strong>
                <span class="text-slate-600 dark:text-slate-400">Certified for Cat6/Cat6A structured data &amp; NBN lines.</span>
              </div>
            </div>

            <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-white/10 shadow-sm dark:shadow-none transition-all">
              <span class="text-amber-600 dark:text-amber-400 font-bold text-base shrink-0">✓</span>
              <div class="text-xs sm:text-sm">
                <strong class="text-slate-900 dark:text-white block font-extrabold">Tidy Rack &amp; Cavity Cabling</strong>
                <span class="text-slate-600 dark:text-slate-400">Immaculate wall plates and patch panel cable management.</span>
              </div>
            </div>

            <div class="flex items-start gap-2.5 p-3.5 rounded-xl bg-white dark:bg-slate-900/80 border border-slate-200 dark:border-white/10 shadow-sm dark:shadow-none transition-all">
              <span class="text-emerald-600 dark:text-emerald-400 font-bold text-base shrink-0">✓</span>
              <div class="text-xs sm:text-sm">
                <strong class="text-slate-900 dark:text-white block font-extrabold">5-Year Workmanship Terms</strong>
                <span class="text-slate-600 dark:text-slate-400">Backed by $20M Public Liability insurance policy.</span>
              </div>
            </div>

          </div>

          <!-- Action Button Row -->
          <div class="pt-3 flex flex-wrap items-center gap-4">
            <a href="#quote" onclick="prefillQuote('Master Cabler Cabling & CCTV Hookup', 'Home / Residential')" class="px-7 py-3.5 rounded-xl bg-gradient-to-r from-blue-600 via-blue-700 to-cyan-600 hover:from-blue-500 hover:to-cyan-500 text-white font-black text-xs uppercase tracking-wider shadow-lg shadow-blue-600/25 transition-all transform hover:-translate-y-0.5">
              Claim Master Cabler Pricing &rarr;
            </a>
            <a href="#pricing" class="px-6 py-3.5 rounded-xl bg-white dark:bg-slate-800/90 hover:bg-slate-100 dark:hover:bg-slate-700 border border-slate-300 dark:border-white/15 text-slate-800 dark:text-white font-black text-xs uppercase tracking-wider shadow-sm transition-all">
              Compare Packages Below &darr;
            </a>
          </div>

        </div>

        <!-- Right Column: Framed Image Placeholder "Master Cabler License Verification" (lg:col-span-4) -->
        <div class="lg:col-span-4">
          <div class="relative mx-auto max-w-sm">
            
            <!-- Metallic Glow Aura -->
            <div class="absolute -inset-1 bg-gradient-to-tr from-blue-400/20 via-cyan-400/25 to-amber-400/20 dark:from-cyan-400/40 dark:via-blue-500/30 dark:to-amber-400/30 rounded-3xl blur-md"></div>

            <!-- Framed Verification Card Container -->
            <div class="relative rounded-2xl p-6 bg-white dark:bg-slate-900/95 border-2 border-blue-400/60 dark:border-cyan-400/50 shadow-xl shadow-blue-500/5 dark:shadow-2xl text-center space-y-4 transition-all">
              
              <!-- Mandatory Label Badge -->
              <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-50 dark:bg-cyan-400/15 border border-blue-200 dark:border-cyan-400/40 text-blue-700 dark:text-cyan-300 text-[11px] font-black uppercase tracking-wider shadow-sm">
                <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                <span>Master Cabler License Verification</span>
              </div>

              <!-- Graphic / Placeholder Shield Box -->
              <div class="relative rounded-xl p-5 bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-white/15 overflow-hidden flex flex-col items-center justify-center space-y-3">
                <!-- Watermark Hologram BG effect -->
                <div class="absolute inset-0 bg-[radial-gradient(#0284c7_1px,transparent_1px)] dark:bg-[radial-gradient(#38bdf8_1px,transparent_1px)] [background-size:12px_12px] opacity-15 dark:opacity-20 pointer-events-none"></div>

                <!-- Verification Medallion / Icon -->
                <div class="w-16 h-16 rounded-2xl bg-gradient-to-br from-blue-600 via-cyan-500 to-indigo-600 p-0.5 shadow-lg shadow-blue-500/20 dark:shadow-cyan-500/30">
                  <div class="w-full h-full rounded-[14px] bg-white dark:bg-slate-950 flex items-center justify-center text-3xl">
                    🛡️
                  </div>
                </div>

                <div class="space-y-1 z-10">
                  <div class="text-xs font-black uppercase tracking-widest text-emerald-600 dark:text-emerald-400 flex items-center justify-center gap-1">
                    <svg class="w-4 h-4 text-emerald-600 dark:text-emerald-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
                    <span>OFFICIALLY VERIFIED</span>
                  </div>
                  <div class="text-sm font-black text-slate-900 dark:text-white">ACMA Open Registered Cabler</div>
                  <div class="text-[11px] text-slate-500 dark:text-slate-400 font-mono">Endorsement: Cat6 / Coaxial / Fibre</div>
                </div>

                <!-- Licence Credential Details -->
                <div class="w-full pt-3 border-t border-slate-200 dark:border-white/10 grid grid-cols-2 gap-2 text-left text-[11px]">
                  <div class="bg-white dark:bg-slate-900/90 p-2 rounded-lg border border-slate-200 dark:border-white/5 shadow-sm dark:shadow-none">
                    <span class="text-slate-500 dark:text-slate-400 block text-[10px]">SECURITY FIRM</span>
                    <span class="text-slate-900 dark:text-white font-bold font-mono">CLASS 1 &amp; 2</span>
                  </div>
                  <div class="bg-white dark:bg-slate-900/90 p-2 rounded-lg border border-slate-200 dark:border-white/5 shadow-sm dark:shadow-none">
                    <span class="text-slate-500 dark:text-slate-400 block text-[10px]">QLD LICENSED</span>
                    <span class="text-slate-900 dark:text-white font-bold font-mono">CARINDALE 4152</span>
                  </div>
                </div>

              </div>

              <!-- Bottom Confirmation Footer -->
              <p class="text-[11px] text-slate-600 dark:text-slate-400 leading-snug">
                Certified Australian Communications and Media Authority (ACMA) compliance for residential &amp; commercial data hookups.
              </p>

            </div>

          </div>
        </div>

      </div>

    </div>
  </div>
</section>
